d
f 
f ./_/_gipc_count.ado
f ./_/_gipc_pk.ado
f ./_/_gipc_sub_count.ado
f ./_/_gipc_sub.ado
f ./_/_gipc_sub0.ado
f ./_/_gipc_sub2_unique.ado
f ./_/_gipc_sub2.ado
f ./_/_gipc_sumstr.ado
f ./_/_gipc_unique_count.ado
f ./_/_gipc_unique_sub.ado
f ./_/_gipc_unique.ado
